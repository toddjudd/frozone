# Copy this file per backup source: config/<name>.env
# This tool knows nothing about what it's backing up — everything
# source-specific lives here, not in the scripts.

# Local directory to back up (required)
SOURCE_PATH=/path/to/source

# rclone remote name, as configured in `rclone config` (required)
S3_REMOTE=s3remote

# S3 bucket name — matches the Terraform output `bucket_name` (required)
S3_BUCKET=todo-set-this-to-your-bucket-name

# Key prefix within the bucket for this source — keep the trailing slash (required)
S3_PREFIX=example/

# Optional: path to a DB dump / extra file or directory to upload alongside
# SOURCE_PATH, stored under "${S3_PREFIX}_db/". Leave commented out to skip.
# DB_DUMP_PATH=/path/to/db-dump.sql

# Optional: override the default log directory (/var/log/frozone)
# LOG_DIR=/var/log/frozone
