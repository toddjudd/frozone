# Copy this file per backup source: config/<name>.env
# This tool knows nothing about what it's backing up — everything
# source-specific lives here, not in the scripts.
#
# Loaded by `op run --env-file=`, so the op:// references below resolve to
# real values before the scripts run. Plain values pass through untouched,
# which is why config and secrets can share one file per instance.

# Local directory to back up (required)
SOURCE_PATH=/path/to/source

# rclone remote name (required). Defined by the RCLONE_CONFIG_* variables
# below rather than by `rclone config`, so no rclone.conf is needed.
# Must be alphanumeric: it becomes part of an environment variable name.
S3_REMOTE=s3remote

# S3 bucket name — matches the Terraform output `bucket_name` (required)
S3_BUCKET=todo-set-this-to-your-bucket-name

# Key prefix within the bucket for this source — keep the trailing slash (required)
S3_PREFIX=example/

# Optional: path to a DB dump / extra file or directory to upload alongside
# SOURCE_PATH, stored under "${S3_PREFIX}_db/". Leave commented out to skip.
# DB_DUMP_PATH=/path/to/db-dump.sql

# Optional: override the default log directory (/var/log/frozone)
# LOG_DIR=/var/log/frozone

# --- Secret references ---------------------------------------------------
# Per-instance, so each source can notify a different Discord account or
# ping its own dead-man's-switch. Format: op://<vault>/<item>/<field>

# Quote any reference whose vault or item name contains spaces: restore.sh
# sources this file with bash, which would otherwise split on them.
DISCORD_BOT_TOKEN=op://homelab/discord-bot/credential
DISCORD_USER_ID=op://homelab/discord-bot/user_id

# Optional: dead-man's-switch ping, e.g. healthchecks.io
HEALTHCHECK_URL=op://homelab/frozone/example_healthcheck_url

# --- Remote definition ---------------------------------------------------
# rclone reads RCLONE_CONFIG_<REMOTE>_<OPTION> from the environment, so the
# remote lives here instead of in rclone.conf and the keys stay in 1Password.
# Replace S3REMOTE with S3_REMOTE above, uppercased.

RCLONE_CONFIG_S3REMOTE_TYPE=s3
RCLONE_CONFIG_S3REMOTE_PROVIDER=AWS
RCLONE_CONFIG_S3REMOTE_REGION=us-east-1
RCLONE_CONFIG_S3REMOTE_SERVER_SIDE_ENCRYPTION=AES256
RCLONE_CONFIG_S3REMOTE_ACCESS_KEY_ID=op://homelab/frozone/access_key
RCLONE_CONFIG_S3REMOTE_SECRET_ACCESS_KEY=op://homelab/frozone/secret_key
