# Templated unit — instantiate per config, e.g.:
#   systemctl enable --now frozone@immich.timer
# where the "immich" instance name maps to config/immich.env
[Unit]
Description=Deep Archive Backup (%i)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# /etc/frozone.env holds only OP_SERVICE_ACCOUNT_TOKEN. systemd parses it
# literally (no shell), so `op run` does the actual secret resolution.
EnvironmentFile=/etc/frozone.env
WorkingDirectory=/opt/frozone
ExecStart=/usr/bin/op run --env-file=/opt/frozone/config/%i.env -- /opt/frozone/scripts/backup.sh %i
